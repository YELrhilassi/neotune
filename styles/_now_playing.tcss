#now-playing {
    height: 5;
    dock: top;
    background: $surface;
    border-bottom: solid $panel;
    padding: 0 1;
}

#np-container {
    height: 100%;
    layout: horizontal;
    align: center middle;
}

/* Left section: Track info  */
#np-info {
    width: 35%;
    height: 100%;
    content-align: left middle;
    padding: 1;
}

#np-track-row {
    height: auto;
    layout: horizontal;
    align: left middle;
}

#np-play-icon {
    width: 3;
    content-align: center middle;
    margin-right: 1;
    color: $text-accent;
}

#np-track-name {
    width: 1fr;
    height: auto;
    content-align: left middle;
    text-style: bold;
    color: $text;
}

#np-meta-row {
    height: auto;
    layout: horizontal;
    align: left middle;
    margin-top: 0;
}

#np-artist-name {
    width: auto;
    height: auto;
    color: $text-muted;
    content-align: left middle;
}

#np-album-name {
    width: auto;
    height: auto;
    color: $text-muted;
    content-align: left middle;
}

#np-meta-sep {
    width: 3;
    content-align: center middle;
    color: $text-muted;
}

/* Center section */
#np-progress-section {
    width: 30%;
    height: 100%;
    layout: horizontal;
    align: center middle;
    padding: 0;
}

#np-time-current {
    width: auto;
    min-width: 4;
    color: $text;
    content-align: center middle;
    margin: 0;
}

#np-progress-bar {
    width: 1fr;
    height: auto;
    min-height: 1;
    margin-left:1;
    padding:0;
    content-align: center middle;
    background: $surface;

}

#np-progress-bar > .bar {
    background: $surface;
}

#np-progress-bar > .bar.-complete {
    background: $accent;
}

#np-time-total {
    width: auto;
    min-width: 4;
    color: $text-muted;
    content-align: center middle;
    margin: 0;
}

/* Right section: Controls (25%) */
#np-controls {
    width: 30%;
    height: 100%;
    layout: horizontal;
    align: right middle;
    padding: 0 1;
}

/* Icon buttons */
.icon-btn {
    width: 3;
    height: 3;
    content-align: center middle;
    color: $text;
    background: transparent;
    border: none;
    text-style: none;
    margin: 0;
    padding: 0;
}

.icon-btn:hover {
    color: $text-accent;
}

.icon-btn:focus {
    color: $accent;
    text-style: bold;
}

.icon-btn.active {
    color: $success;
}

.icon-btn.track {
    color: $warning;
}

.icon-btn.liked {
    color: $error;
}

/* Clickable labels */
ClickableLabel:focus {
    text-style: underline;
    color: $text-accent;
}

/* Like button spacing */
#np-like-btn {
    margin-right: 1;
}

/* Volume section */
#np-volume-section {
    width: auto;
    height: 100%;
    layout: horizontal;
    align: center middle;
    margin-left: 2;
    padding: 0;
}

#np-volume-icon {
    width: 3;
    content-align: center middle;
    color: $text-muted;
}

#np-volume-bar {
    width: 8;
    height: auto;
    min-height: 1;
    margin: 0 1;
    padding: 0;
    content-align: center middle;
    background: $surface;
    border: none;
}

#np-volume-bar > .bar {
    background: $surface;
}

#np-volume-bar > .bar.-complete {
    background: $success;
}

#np-volume-text {
    width: auto;
    min-width: 3;
    content-align: center middle;
    color: $text-muted;
}
